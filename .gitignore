# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Generated docs (forge doc), but never the vector corpus — it is the test suite.
# A parent directory cannot be un-ignored from within, hence docs/* rather than docs/.
docs/*
!docs/vectors/

# Dotenv file
.env
.env.*
!.env.example

# rust
/rust/target

# foundry
/out
/cache
/broadcast
